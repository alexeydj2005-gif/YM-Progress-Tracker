const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const catalog=[
{name:"Press de banca",muscle:"Pecho",type:"Compuesto",equipment:"Barra",description:"Ejercicio principal para desarrollar fuerza y masa muscular del pectoral.",instructions:["Acuéstate en el banco con los pies firmes en el suelo.","Sujeta la barra ligeramente más allá del ancho de los hombros.","Baja la barra de forma controlada hasta el pecho.","Empuja hacia arriba sin perder la estabilidad de los hombros."],icon:"🏋️",level:"Intermedio"},
{name:"Press inclinado con mancuernas",muscle:"Pecho",type:"Compuesto",equipment:"Mancuernas",description:"Variación inclinada que enfatiza la porción clavicular del pectoral.",instructions:["Ajusta el banco entre 30 y 45 grados.","Mantén las mancuernas a los lados del pecho.","Empuja hacia arriba y ligeramente hacia dentro.","Desciende lentamente hasta una posición cómoda."],icon:"💪",level:"Intermedio"},
{name:"Aperturas en polea",muscle:"Pecho",type:"Aislamiento",equipment:"Polea",description:"Movimiento de aislamiento para trabajar la aducción horizontal del hombro.",instructions:["Coloca las poleas a la altura del pecho.","Da un paso al frente y flexiona ligeramente los codos.","Junta las manos frente al torso sin encoger los hombros.","Regresa de forma controlada."],icon:"〰️",level:"Principiante"},
{name:"Jalón al pecho",muscle:"Espalda",type:"Compuesto",equipment:"Polea",description:"Tracción vertical orientada al dorsal ancho y la musculatura de la espalda.",instructions:["Sujeta la barra con agarre algo más ancho que los hombros.","Inclina el torso ligeramente y lleva los hombros abajo.","Tira de la barra hacia la parte alta del pecho.","Extiende los brazos lentamente sin perder el control."],icon:"↘️",level:"Principiante"},
{name:"Remo con barra",muscle:"Espalda",type:"Compuesto",equipment:"Barra",description:"Ejercicio de tracción horizontal para espalda media, dorsales y estabilizadores.",instructions:["Coloca los pies al ancho de caderas y flexiona la cadera.","Mantén la espalda neutra y el abdomen firme.","Lleva la barra hacia la zona baja de las costillas.","Baja la barra lentamente sin redondear la espalda."],icon:"🏋️",level:"Intermedio"},
{name:"Peso muerto",muscle:"Piernas",type:"Compuesto",equipment:"Barra",description:"Movimiento multiarticular de bisagra de cadera que involucra cadena posterior y piernas.",instructions:["Coloca la barra sobre la mitad del pie.","Flexiona cadera y rodillas manteniendo la espalda neutra.","Empuja el suelo y extiende cadera y rodillas a la vez.","Devuelve la barra al suelo con control."],icon:"⬆️",level:"Avanzado"},
{name:"Sentadilla",muscle:"Piernas",type:"Compuesto",equipment:"Barra",description:"Patrón básico de flexión de rodilla y cadera para cuádriceps y glúteos.",instructions:["Apoya la barra de forma estable sobre la parte alta de la espalda.","Separa los pies aproximadamente al ancho de hombros.","Desciende flexionando cadera y rodillas.","Empuja el suelo para volver a la posición inicial."],icon:"🦵",level:"Intermedio"},
{name:"Prensa de piernas",muscle:"Piernas",type:"Compuesto",equipment:"Máquina",description:"Ejercicio guiado para trabajar principalmente cuádriceps y glúteos.",instructions:["Apoya toda la espalda en el respaldo.","Coloca los pies en la plataforma al ancho de hombros.","Desbloquea el seguro y baja la plataforma de forma controlada.","Empuja sin bloquear bruscamente las rodillas."],icon:"🦿",level:"Principiante"},
{name:"Press militar",muscle:"Hombros",type:"Compuesto",equipment:"Mancuernas",description:"Empuje vertical para desarrollar deltoides y estabilidad del tren superior.",instructions:["Coloca las mancuernas a la altura de los hombros.","Activa el abdomen y evita arquear la zona lumbar.","Empuja las mancuernas por encima de la cabeza.","Baja lentamente hasta la posición inicial."],icon:"🙌",level:"Intermedio"},
{name:"Elevaciones laterales",muscle:"Hombros",type:"Aislamiento",equipment:"Mancuernas",description:"Aislamiento del deltoides medio para el trabajo de anchura del hombro.",instructions:["Sostén las mancuernas a los lados del cuerpo.","Eleva los brazos lateralmente con codos ligeramente flexionados.","Detente aproximadamente a la altura de los hombros.","Desciende lentamente sin balancear el torso."],icon:"↗️",level:"Principiante"},
{name:"Curl de bíceps",muscle:"Brazos",type:"Aislamiento",equipment:"Mancuernas",description:"Flexión de codo enfocada en el bíceps braquial.",instructions:["Mantén los codos cerca del torso.","Flexiona los codos sin mover los hombros.","Acerca las mancuernas hacia los hombros.","Extiende los brazos lentamente."],icon:"💪",level:"Principiante"},
{name:"Extensión de tríceps en polea",muscle:"Brazos",type:"Aislamiento",equipment:"Polea",description:"Movimiento de extensión de codo para trabajar el tríceps.",instructions:["Sujeta la cuerda con los codos pegados al cuerpo.","Extiende los codos llevando las manos hacia abajo.","Separa ligeramente los extremos al final del recorrido.","Regresa de forma controlada."],icon:"🔱",level:"Principiante"},
{name:"Plancha abdominal",muscle:"Core",type:"Isométrico",equipment:"Peso corporal",description:"Trabajo isométrico de estabilidad anterior del tronco.",instructions:["Apoya antebrazos y puntas de los pies.","Alinea cabeza, cadera y talones.","Contrae abdomen y glúteos.","Mantén la posición sin dejar caer la cadera."],icon:"🧘",level:"Principiante"}
];
const initial={profile:{name:"Jordan Luna",email:"jordan@example.com",height:175,weight:74.5},exercises:catalog.map((x,i)=>({id:i+1,...x,builtin:true})),routines:[{id:1,name:"Push Day",focus:"Pecho · Hombros · Tríceps",days:"Lunes / Jueves",minutes:60,items:["Press de banca","Press militar","Fondos"]},{id:2,name:"Pull Day",focus:"Espalda · Bíceps",days:"Martes / Viernes",minutes:55,items:["Jalón al pecho","Remo con barra","Curl de bíceps"]},{id:3,name:"Leg Day",focus:"Piernas · Glúteos",days:"Miércoles / Sábado",minutes:65,items:["Sentadilla","Peso muerto","Prensa"]}],sessions:[{id:1,name:"Push Day",date:"2026-11-19",exercises:5,volume:2450},{id:2,name:"Pull Day",date:"2026-11-17",exercises:6,volume:2180},{id:3,name:"Leg Day",date:"2026-11-15",exercises:5,volume:2820}],progress:[{date:"2026-11-19",weight:74.5,waist:82,chest:98,note:"Medición inicial"},{date:"2026-11-05",weight:74.8,waist:83,chest:97,note:"Seguimiento"},{date:"2026-10-20",weight:75.1,waist:83.5,chest:97,note:"Seguimiento"},{date:"2026-10-05",weight:75.3,waist:84,chest:96,note:"Seguimiento"}]};
let d;try{d=JSON.parse(localStorage.getItem("gpt-demo"))||initial}catch{d=initial}d.exercises=(d.exercises||[]).map(e=>{let preset=catalog.find(c=>c.name.toLowerCase()===String(e.name||"").toLowerCase());return {...(preset||{}),...e,type:e.type||preset?.type||"Compuesto",description:e.description||preset?.description||"Ejercicio registrado en tu biblioteca.",instructions:e.instructions||preset?.instructions||["Adopta una posición estable.","Realiza el movimiento de forma controlada.","Mantén una técnica adecuada durante toda la repetición."],icon:e.icon||preset?.icon||"🏋️",level:e.level||preset?.level||"Intermedio",builtin:e.builtin??!!preset}});const save=()=>localStorage.setItem("gpt-demo",JSON.stringify(d)),date=s=>new Date(s+"T12:00:00").toLocaleDateString("es-EC",{day:"2-digit",month:"short",year:"numeric"}),num=n=>Number(n).toLocaleString("en-US"),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function toast(t){$("#toast").textContent=t;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),2200)}
function go(id){$$(".page").forEach(x=>x.classList.toggle("active",x.id===id));$$("[data-page]").forEach(x=>x.classList.toggle("active",x.dataset.page===id));$("#crumb").textContent=id.toUpperCase();$(".sidebar").classList.remove("open");render()}
$$("[data-page]").forEach(x=>x.onclick=()=>go(x.dataset.page));$("#menu").onclick=()=>$(".sidebar").classList.toggle("open");$("#today").textContent=new Date().toLocaleDateString("es-EC",{weekday:"short",day:"2-digit",month:"short"}).toUpperCase();
function render(){
$("#sideName").textContent=d.profile.name;$("#statExercises").textContent=d.exercises.length;$("#statWeight").innerHTML=d.profile.weight+" <i>kg</i>";$("#statSessions").textContent=d.sessions.length+9;$("#statVolume").innerHTML=num(d.sessions.reduce((a,x)=>a+x.volume,0)+3450)+" <i>kg</i>";
$("#recent").innerHTML=d.sessions.slice(0,3).map(s=>`<div class="recent"><div><b>${esc(s.name)}</b><small>${date(s.date)} · ${s.exercises} ejercicios</small></div><b>${num(s.volume)} kg</b></div>`).join("");
renderExercises();
$("#routineCount").textContent=d.routines.length;$("#routineItems").textContent=d.routines.reduce((a,r)=>a+r.items.length,0);$("#routineGrid").innerHTML=d.routines.map(r=>`<article class="routine"><h3>${esc(r.name)}</h3><p>${esc(r.focus)}</p><p>◷ ${r.minutes} min　 ·　 ${esc(r.days)}</p>${r.items.map((x,i)=>`<p>${i+1}. ${esc(x)}　<small>3 × 10</small></p>`).join("")}<div class="actions"><button data-del-routine="${r.id}">Eliminar rutina</button></div></article>`).join("");
let volume=d.sessions.reduce((a,s)=>a+s.volume,0);$("#sessionCount").textContent=d.sessions.length;$("#sessionVolume").innerHTML=num(volume)+" <i>kg</i>";$("#lastSession").textContent=d.sessions[0]?date(d.sessions[0].date):"—";$("#sessionRows").innerHTML=d.sessions.map(s=>`<tr><td><b>${esc(s.name)}</b></td><td>${date(s.date)}</td><td>${s.exercises}</td><td>${num(s.volume)} kg</td><td><span class="lime">Completada</span></td><td><button data-del-session="${s.id}">Eliminar</button></td></tr>`).join("");
let m=d.progress[0]||{weight:d.profile.weight};$("#progressWeight").textContent=m.weight+" kg";$("#metricWeight").textContent=m.weight+" kg";$("#metricHeight").textContent=(d.profile.height/100).toFixed(2)+" m";$("#metricBmi").textContent=(m.weight/((d.profile.height/100)**2)).toFixed(1);$("#metricCount").textContent=d.progress.length;$("#progressRows").innerHTML=d.progress.map(x=>`<tr><td>${date(x.date)}</td><td>${x.weight} kg</td><td>${x.waist||"—"} cm</td><td>${x.chest||"—"} cm</td><td>${esc(x.note)}</td></tr>`).join("");
$("#name").value=d.profile.name;$("#email").value=d.profile.email;$("#height").value=d.profile.height;$("#weight").value=d.profile.weight;$("#profileNameTitle").textContent=d.profile.name;
}
function openModal(type,id){$(".modal").classList.remove("detail-modal");let e=d.exercises.find(x=>x.id===id),title={exercise:e?"Editar ejercicio":"Nuevo ejercicio",routine:"Crear rutina",session:"Registrar sesión",progress:"Añadir medición"}[type];$("#modalTitle").textContent=title;let fields={
exercise:`<label>Nombre del ejercicio<input name="name" required maxlength="100" value="${esc(e?.name||"")}" placeholder="Ej. Press de banca"></label><label>Grupo muscular principal<select name="muscle">${["Pecho","Espalda","Piernas","Hombros","Brazos","Core"].map(x=>`<option ${e?.muscle===x?"selected":""}>${x}</option>`).join("")}</select></label><label>Tipo de ejercicio<select name="type">${["Compuesto","Aislamiento","Isométrico"].map(x=>`<option ${e?.type===x?"selected":""}>${x}</option>`).join("")}</select></label><label>Equipamiento<select name="equipment">${["Barra","Mancuernas","Máquina","Polea","Peso corporal","Banco","Otro"].map(x=>`<option ${e?.equipment===x?"selected":""}>${x}</option>`).join("")}</select></label><label>Descripción<textarea name="description" rows="3" required maxlength="500" placeholder="Describe el objetivo y ejecución general">${esc(e?.description||"")}</textarea></label>`,
routine:`<label>Nombre<input name="name" required placeholder="Upper Body"></label><label>Enfoque muscular<input name="focus" required placeholder="Pecho · Espalda"></label><label>Días<input name="days" placeholder="Lunes / Jueves"></label><label>Duración (min)<input name="minutes" type="number" value="60"></label><label>Ejercicios separados por coma<input name="items" required placeholder="Press banca, Remo, Curl"></label>`,
session:`<label>Entrenamiento<input name="name" required placeholder="Push Day"></label><label>Fecha<input name="date" type="date" value="${new Date().toISOString().slice(0,10)}"></label><label>Número de ejercicios<input name="exercises" type="number" value="5" min="1"></label><label>Volumen total (kg)<input name="volume" type="number" value="1500" min="0"></label>`,
progress:`<label>Fecha<input name="date" type="date" value="${new Date().toISOString().slice(0,10)}"></label><label>Peso (kg)<input name="weight" type="number" step=".1" value="${d.profile.weight}"></label><label>Cintura (cm)<input name="waist" type="number" step=".1"></label><label>Pecho (cm)<input name="chest" type="number" step=".1"></label><label>Notas<input name="note" placeholder="Observaciones"></label>`};
$("#modalContent").innerHTML=`<form id="modalForm" class="modal-form">${fields[type]}<button class="primary">Guardar</button></form>`;$("#backdrop").classList.add("open");$("#modalForm").onsubmit=ev=>{ev.preventDefault();let f=new FormData(ev.target),v=Object.fromEntries(f.entries());if(type==="exercise"){let obj={id:e?.id||Date.now(),name:v.name,muscle:v.muscle,type:v.type,equipment:v.equipment,description:v.description,instructions:e?.instructions||["Adopta una posición estable.","Realiza el movimiento de forma controlada.","Mantén una técnica adecuada durante toda la repetición."],icon:e?.icon||"🏋️",level:e?.level||"Personalizado",builtin:false};if(e)d.exercises=d.exercises.map(x=>x.id===e.id?obj:x);else d.exercises.unshift(obj)}if(type==="routine")d.routines.unshift({id:Date.now(),name:v.name,focus:v.focus,days:v.days,minutes:+v.minutes,items:v.items.split(",").map(x=>x.trim()).filter(Boolean)});if(type==="session")d.sessions.unshift({id:Date.now(),name:v.name,date:v.date,exercises:+v.exercises,volume:+v.volume});if(type==="progress"){d.progress.unshift({date:v.date,weight:+v.weight,waist:+v.waist||null,chest:+v.chest||null,note:v.note});d.profile.weight=+v.weight}save();$("#backdrop").classList.remove("open");render();toast("Registro guardado correctamente.")}}
$$("[data-modal]").forEach(x=>x.onclick=()=>openModal(x.dataset.modal));$("#close").onclick=()=>{$("#backdrop").classList.remove("open");$(".modal").classList.remove("detail-modal")};$("#backdrop").onclick=e=>{if(e.target.id==="backdrop")$("#backdrop").classList.remove("open")};
document.addEventListener("click",e=>{let detail=e.target.closest("[data-detail]");if(detail)showExerciseDetail(+detail.dataset.detail);let x=e.target.closest("[data-edit]");if(x)openModal("exercise",+x.dataset.edit);for(let [a,k] of [["data-del-ex","exercises"],["data-del-routine","routines"],["data-del-session","sessions"]]){let b=e.target.closest("["+a+"]");if(b&&confirm("¿Eliminar este registro?")){d[k]=d[k].filter(o=>o.id!==+b.getAttribute(a));save();render();toast("Registro eliminado.")}}});
let exerciseTab="all";
["searchExercise","filterMuscle","filterType","filterEquipment"].forEach(id=>$("#"+id).addEventListener(id==="searchExercise"?"input":"change",renderExercises));
$$('[data-exercise-tab]').forEach(b=>b.onclick=()=>{exerciseTab=b.dataset.exerciseTab;$$('[data-exercise-tab]').forEach(x=>x.classList.toggle("active",x===b));renderExercises()});
function renderExercises(){if(!$("#exerciseGrid"))return;let q=$("#searchExercise").value.toLowerCase(),m=$("#filterMuscle").value,t=$("#filterType").value,eq=$("#filterEquipment").value;let items=d.exercises.filter(e=>(exerciseTab==="all"||(exerciseTab==="builtin"&&e.builtin)||(exerciseTab==="custom"&&!e.builtin))&&(!q||[e.name,e.muscle,e.equipment,e.type,e.description].join(" ").toLowerCase().includes(q))&&(!m||e.muscle===m)&&(!t||e.type===t)&&(!eq||e.equipment===eq));let built=d.exercises.filter(e=>e.builtin).length;$("#exerciseCount").textContent=d.exercises.length+" ejercicios";$("#builtInCount").textContent=built;$("#customCount").textContent=d.exercises.length-built;$("#filteredCount").textContent=items.length+" resultados";$("#exerciseEmpty").hidden=items.length>0;$("#exerciseGrid").innerHTML=items.map((e,i)=>`<article class="library-card"><div class="exercise-art"><span class="art-number">EX / ${String(i+1).padStart(2,"0")}</span><span class="art-icon">${esc(e.icon)}</span><span class="art-label">${esc(e.muscle)}</span></div><div class="library-card-body"><div class="library-card-top"><span class="muscle-chip">${esc(e.muscle)}</span><span class="kind-chip">${esc(e.builtin?"Predefinido":"Personalizado")}</span></div><h3>${esc(e.name)}</h3><p>${esc(e.description)}</p><div class="exercise-meta"><span>${esc(e.type)}</span><span>◈ ${esc(e.equipment)}</span></div><div class="library-card-actions"><button data-detail="${e.id}">Ver ficha</button>${e.builtin?"":`<button data-edit="${e.id}">Editar</button><button data-del-ex="${e.id}">Eliminar</button>`}</div></div></article>`).join("")}
function showExerciseDetail(id){let e=d.exercises.find(x=>x.id===id);if(!e)return;$("#modalTitle").textContent="Ficha del ejercicio";$("#modalContent").innerHTML=`<div class="detail-hero"><div class="exercise-art"><span class="art-icon">${esc(e.icon)}</span></div><div><h3>${esc(e.name)}</h3><span class="muscle-chip">${esc(e.muscle)}</span><div class="detail-badges"><span class="kind-chip">${esc(e.type)}</span><span class="kind-chip">${esc(e.equipment)}</span><span class="kind-chip">${esc(e.level||"—")}</span></div></div></div><div class="detail-section"><h4>Descripción</h4><p>${esc(e.description)}</p></div><div class="detail-section"><h4>Cómo ejecutarlo</h4><ol>${(e.instructions||[]).map(x=>`<li>${esc(x)}</li>`).join("")}</ol></div><div class="detail-section"><p>Esta ficha es una guía general. Ajusta el rango de movimiento y la carga a tu capacidad y utiliza una técnica controlada.</p></div><div class="actions"><button id="detailClose" class="primary">Cerrar ficha</button></div>`;$("#backdrop").classList.add("open");$(".modal").classList.add("detail-modal");$("#detailClose").onclick=()=>{$("#backdrop").classList.remove("open");$(".modal").classList.remove("detail-modal")}}
$("#searchSession").oninput=e=>$$("tbody tr").forEach(x=>x.hidden=!x.textContent.toLowerCase().includes(e.target.value.toLowerCase()));
$("#saveProfile").onclick=()=>{$("#profileForm").requestSubmit()};$("#profileForm").onsubmit=e=>{e.preventDefault();d.profile={name:$("#name").value,email:$("#email").value,height:+$("#height").value,weight:+$("#weight").value};save();render();toast("Perfil actualizado.")};render();
