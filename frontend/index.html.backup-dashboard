<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Gym Progress Tracker</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="styles.css"></head>
<body>
<section id="authScreen" class="auth-screen">
  <div class="auth-card">
    <div class="auth-brand"><b>G<span>+</span></b><div><strong>GYM TRACKER</strong><small>TRAINING INTELLIGENCE</small></div></div>
    <p class="auth-kicker">TU ENTRENAMIENTO, BAJO CONTROL</p>
    <h1 id="authTitle">Inicia sesión<span>.</span></h1>
    <p class="auth-subtitle" id="authSubtitle">Accede a tu espacio personal de entrenamiento.</p>
    <form id="authForm" class="auth-form">
      <label id="authNameWrap" hidden>Nombre completo<input id="authName" autocomplete="name" maxlength="100" placeholder="Tu nombre"></label>
      <label>Correo electrónico<input id="authEmail" type="email" autocomplete="email" required placeholder="correo@ejemplo.com"></label>
      <label>Contraseña<input id="authPassword" type="password" autocomplete="current-password" minlength="8" required placeholder="Mínimo 8 caracteres"></label>
      <p id="authError" class="auth-error" role="alert"></p>
      <button class="primary auth-submit" id="authSubmit">Iniciar sesión</button>
    </form>
    <p class="auth-switch"><span id="authSwitchText">¿No tienes cuenta?</span> <button type="button" id="authToggle">Crear cuenta</button></p>
  </div>
</section>
<div id="appShell" hidden>
<aside class="sidebar"><div class="brand"><b>G<span>+</span></b><div><strong>GYM TRACKER</strong><small>TRAINING INTELLIGENCE</small></div></div><label>WORKSPACE</label><nav>
<button class="active" data-page="dashboard">▦　Dashboard</button><button data-page="exercises">◈　Ejercicios</button><button data-page="routines">▤　Rutinas</button><button data-page="sessions">◷　Sesiones</button><button data-page="progress">↗　Progreso</button></nav><div class="side-bottom"><div class="tip"><span>✦</span><b>Tu progreso, sin límites.</b><p>Registra cada sesión. Construye mejores hábitos.</p></div><button data-page="profile">⚙　Mi perfil</button><div class="user"><i id="sideInitials">JL</i><div><b id="sideName">Jordan Luna</b><small>Atleta</small></div><button id="logoutButton" class="logout-button">Cerrar sesión</button></div></div></aside>
<main><header><button id="menu" class="menu">☰</button><div>WORKSPACE　/　<b id="crumb">DASHBOARD</b></div><span id="today"></span></header>
<section id="dashboard" class="page active"><div class="heading"><div><small>TU CENTRO DE ENTRENAMIENTO</small><h1>Dashboard<span>.</span></h1><p>Tu esfuerzo de hoy construye los resultados de mañana.</p></div><button class="primary" data-modal="session">＋ Registrar sesión</button></div>
<div class="hero"><div><small>POTENCIAL EN CONSTRUCCIÓN</small><h2>Entrena con intención.</h2><p>La constancia convierte los objetivos en resultados medibles.</p></div><div class="weekly"><small>OBJETIVO SEMANAL</small><strong>04 <em>/ 05</em></strong><div class="bar"><i style="width:80%"></i></div><small>80% completado</small></div><div class="orbit">G<span>+</span></div></div>
<div class="section-title"><div><h3>Resumen de actividad</h3><p>Indicadores principales de tu entrenamiento</p></div><span class="pill">ESTA SEMANA　⌄</span></div>
<div class="stats"><article><small>SESIONES</small><b id="statSessions">12</b><p><span>↗ 2</span> vs. semana anterior</p></article><article><small>VOLUMEN TOTAL</small><b id="statVolume">8,450 <i>kg</i></b><p><span>↗ 8.4%</span> vs. semana anterior</p></article><article><small>PESO CORPORAL</small><b id="statWeight">74.5 <i>kg</i></b><p><span>— 0.3 kg</span> último registro</p></article><article><small>EJERCICIOS</small><b id="statExercises">24</b><p><span>ACTIVOS</span> en tu biblioteca</p></article></div>
<div class="columns"><article class="panel"><div class="panel-head"><div><h3>Volumen de entrenamiento</h3><p>Rendimiento semanal · kilogramos</p></div><span class="pill">ÚLTIMOS 7 DÍAS</span></div><div class="chart"><div class="y"><span>3k</span><span>2k</span><span>1k</span><span>0</span></div><svg viewBox="0 0 600 190" preserveAspectRatio="none"><path class="grid" d="M0 10H600M0 65H600M0 120H600M0 175H600"/><path class="area" d="M0 140 Q40 130 80 105T170 120T260 70T350 90T440 45T530 60T600 20V175H0Z"/><path class="line" d="M0 140 Q40 130 80 105T170 120T260 70T350 90T440 45T530 60T600 20"/></svg></div><div class="days"><span>LUN</span><span>MAR</span><span>MIÉ</span><span>JUE</span><span>VIE</span><span>SÁB</span><span>DOM</span></div></article>
<article class="panel"><div class="panel-head"><div><h3>Distribución muscular</h3><p>Enfoque de tus sesiones</p></div></div><div class="muscles"><div class="donut"><b>100<small>%</small></b></div><div class="legend"><p>🟩 Pecho <b>32%</b></p><p>🟢 Espalda <b>26%</b></p><p>🟦 Piernas <b>24%</b></p><p>⬛ Otros <b>18%</b></p></div></div></article></div>
<div class="columns lower"><article class="panel"><div class="panel-head"><div><h3>Sesiones recientes</h3><p>Tu historial de entrenamiento</p></div><button class="link" data-page="sessions">Ver historial ↗</button></div><div id="recent"></div></article><article class="panel"><h3>Objetivo semanal</h3><p>Pequeños pasos, grandes cambios</p><h2 class="goal">4 <small>/ 5 sesiones</small></h2><div class="bar"><i style="width:80%"></i></div><p>¡Vas por buen camino! <b class="lime">80%</b></p></article></div></section>
<section id="exercises" class="page"><div class="heading"><div><small>02 / BIBLIOTECA DE MOVIMIENTOS</small><h1>Biblioteca de ejercicios<span>.</span></h1><p>Explora movimientos, consulta su técnica y administra tu catálogo personal.</p></div><button class="primary" data-modal="exercise">＋ Crear ejercicio</button></div>
<div class="library-overview"><div><span class="library-kicker">CATÁLOGO DISPONIBLE</span><strong id="exerciseCount">0 ejercicios</strong><small>Movimientos predefinidos y personalizados</small></div><div class="library-stat"><b id="builtInCount">0</b><small>PREDEFINIDOS</small></div><div class="library-stat"><b id="customCount">0</b><small>PERSONALIZADOS</small></div></div>
<div class="library-tools"><label class="search-box"><span>⌕</span><input id="searchExercise" placeholder="Buscar por nombre, músculo o equipamiento..."></label><select id="filterMuscle"><option value="">Todos los músculos</option><option>Pecho</option><option>Espalda</option><option>Piernas</option><option>Hombros</option><option>Brazos</option><option>Core</option></select><select id="filterType"><option value="">Todos los tipos</option><option>Compuesto</option><option>Aislamiento</option><option>Isométrico</option></select><select id="filterEquipment"><option value="">Todo el equipamiento</option><option>Barra</option><option>Mancuernas</option><option>Máquina</option><option>Polea</option><option>Peso corporal</option><option>Banco</option></select></div>
<div class="library-tabs"><button class="library-tab active" data-exercise-tab="all">Todos</button><button class="library-tab" data-exercise-tab="builtin">Predefinidos</button><button class="library-tab" data-exercise-tab="custom">Mis ejercicios</button><span id="filteredCount"></span></div>
<div id="exerciseGrid" class="exercise-library-grid"></div><div id="exerciseEmpty" class="empty-state" hidden><span>⌕</span><b>No se encontraron ejercicios</b><p>Prueba con otro término o cambia los filtros.</p></div></section>
<section id="routines" class="page"><div class="heading"><div><small>PLANIFICACIÓN</small><h1>Mis rutinas<span>.</span></h1><p>Diseña sesiones que se adapten a tus objetivos.</p></div><button class="primary" data-modal="routine">＋ Crear rutina</button></div><div class="summary"><article><small>RUTINAS CREADAS</small><b id="routineCount">03</b></article><article><small>EJERCICIOS PLANIFICADOS</small><b id="routineItems">18</b></article><article><small>TIEMPO PROMEDIO</small><b>55 <i>min</i></b></article></div><div id="routineGrid" class="cards"></div></section>
<section id="sessions" class="page"><div class="heading"><div><small>REGISTRO DE ACTIVIDAD</small><h1>Sesiones<span>.</span></h1><p>Consulta y registra el trabajo que has realizado.</p></div><button class="primary" data-modal="session">＋ Registrar sesión</button></div><div class="summary"><article><small>SESIONES REGISTRADAS</small><b id="sessionCount">0</b></article><article><small>VOLUMEN ACUMULADO</small><b id="sessionVolume">0 <i>kg</i></b></article><article><small>ÚLTIMA ACTIVIDAD</small><b id="lastSession">—</b></article></div><article class="panel table-panel"><div class="panel-head"><div><h3>Historial de entrenamiento</h3><p>Registro cronológico de tus sesiones</p></div><input id="searchSession" placeholder="Buscar sesión..."></div><div class="scroll"><table><thead><tr><th>ENTRENAMIENTO</th><th>FECHA</th><th>EJERCICIOS</th><th>VOLUMEN</th><th>ESTADO</th><th></th></tr></thead><tbody id="sessionRows"></tbody></table></div></article></section>
<section id="progress" class="page"><div class="heading"><div><small>ANÁLISIS PERSONAL</small><h1>Mi progreso<span>.</span></h1><p>Los datos muestran el camino que estás construyendo.</p></div><button class="primary" data-modal="progress">＋ Añadir medición</button></div><div class="hero progress-hero"><div><small>ÚLTIMO PESO REGISTRADO</small><h2 id="progressWeight">74.5 kg</h2><p>Tu evolución empieza con el seguimiento.</p></div><div class="weekly"><small>OBJETIVO PERSONAL</small><strong>72.0 <em>kg</em></strong><small>Meta editable desde tu perfil</small></div></div><div class="columns"><article class="panel"><h3>Evolución del peso</h3><p>Mediciones corporales registradas</p><div class="chart"><svg viewBox="0 0 600 190" preserveAspectRatio="none"><path class="grid" d="M0 10H600M0 65H600M0 120H600M0 175H600"/><path class="line" d="M0 35Q100 50 180 65T300 90T420 120T600 145"/></svg></div></article><article class="panel"><h3>Indicadores físicos</h3><div class="metrics"><p>Peso corporal <b id="metricWeight">74.5 kg</b></p><p>Altura <b id="metricHeight">1.75 m</b></p><p>IMC estimado <b id="metricBmi">24.3</b></p><p>Mediciones <b id="metricCount">04</b></p></div></article></div><article class="panel table-panel"><h3>Historial de mediciones</h3><div class="scroll"><table><thead><tr><th>FECHA</th><th>PESO</th><th>CINTURA</th><th>PECHO</th><th>NOTAS</th></tr></thead><tbody id="progressRows"></tbody></table></div></article></section>
<section id="profile" class="page"><div class="heading"><div><small>CONFIGURACIÓN PERSONAL</small><h1>Mi perfil<span>.</span></h1><p>Administra la información de tu cuenta y tus objetivos.</p></div><button class="primary" id="saveProfile">Guardar cambios</button></div><div class="columns"><article class="panel profile-card"><div class="avatar">JL</div><h3 id="profileNameTitle">Jordan Luna</h3><p>Miembro de Gym Tracker</p><span class="pill">ATLETA</span></article><article class="panel"><h3>Información personal</h3><p>Datos básicos del perfil.</p><form id="profileForm" class="form"><label>Nombre completo<input id="name" value="Jordan Luna"></label><label>Correo electrónico<input id="email" type="email" value="jordan@example.com"></label><label>Altura (cm)<input id="height" type="number" value="175"></label><label>Peso actual (kg)<input id="weight" type="number" step=".1" value="74.5"></label><button class="primary">Guardar perfil</button></form></article></div></section>
<footer>GYM PROGRESS TRACKER　•　FRONTEND PREVIEW <span>BUILT FOR CONSISTENCY ✦</span></footer></main>
<div class="backdrop" id="backdrop"><div class="modal"><div class="modal-head"><div><small>GYM PROGRESS TRACKER</small><h2 id="modalTitle">Nuevo registro</h2></div><button id="close">×</button></div><div id="modalContent"></div></div></div><div id="toast"></div><script src="app.js"></script>
</div>
</body></html>