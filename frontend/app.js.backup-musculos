    "Piernas": ["Glúteos"],
    "Hombros": ["Tríceps"],
    "Brazos": [],
    "Core": []
};

const secondaryMusclesFor = exercise => {
    const name = String(exercise.name || "").toLowerCase();

    if (name.includes("press") && name.includes("banca")) return ["Tríceps", "Hombros"];
    if (name.includes("press") && name.includes("inclinado")) return ["Tríceps", "Hombros"];
    if (name.includes("sentadilla")) return ["Glúteos", "Core"];
    if (name.includes("peso muerto")) return ["Glúteos", "Espalda"];
    if (name.includes("dominada") || name.includes("jalón")) return ["Bíceps"];
    if (name.includes("remo")) return ["Bíceps", "Hombros"];
    if (name.includes("press militar")) return ["Tríceps"];
    if (name.includes("fondos")) return ["Pecho", "Hombros"];
    if (name.includes("hip thrust")) return ["Isquiotibiales"];
    return secondaryMuscleMap[exercise.muscle] || [];
};


