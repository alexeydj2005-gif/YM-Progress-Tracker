</div>
<div class="body-view">
<h4>POSTERIOR</h4>
<svg viewBox="0 0 220 430" role="img" aria-label="Anatomía muscular posterior">
<g class="body-base">
<path d="M92 25 Q110 8 128 25 L132 48 Q151 55 166 77 L181 145 L161 153 L148 111 L145 177 L139 215 L151 280 L159 386 L137 390 L120 291 L110 235 L100 291 L83 390 L61 386 L69 280 L81 215 L75 177 L72 111 L59 153 L39 145 L54 77 Q69 55 88 48 Z"/>
</g>
<g class="muscle-parts">
<path data-muscle="Hombros" d="M87 57 Q65 53 57 79 L73 100 L91 83 Z"/>
<path data-muscle="Hombros" d="M133 57 Q155 53 163 79 L147 100 L129 83 Z"/>
