<path data-muscle="Espalda" d="M93 164 L127 164 L133 208 L87 208 Z"/>
<path data-muscle="Piernas" d="M83 213 L108 213 L101 287 L76 280 Z"/>
<path data-muscle="Piernas" d="M112 213 L137 213 L144 280 L119 287 Z"/>
